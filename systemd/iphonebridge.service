[Unit]
Description=iphonebridge — iPhone↔Linux Bluetooth bridge
Documentation=https://github.com/santisbon/iphonebridge
After=bluetooth.target graphical-session.target dbus.socket
Wants=bluetooth.target
Requires=dbus.socket

[Service]
Type=simple
# Source per-machine config (IPHONEBRIDGE_MAC etc.). Leading `-` means
# the file is optional — the service starts even if it's missing, but
# `iphonebridge doctor` will then warn that the MAC isn't configured.
EnvironmentFile=-%h/.config/iphonebridge/local.env
# @INSTALL_DIR@ is substituted for your clone path at install time —
# see README install step 5. A plain `cp` of this file will not work.
ExecStart=@INSTALL_DIR@/.venv/bin/iphonebridge run
Restart=on-failure
RestartSec=5
# Wait up to 10s for clean shutdown
TimeoutStopSec=10
# Keep journald logs
StandardOutput=journal
StandardError=journal
# Confinement comes from AppArmor: the package's profile in
# /etc/apparmor.d/iphonebridge attaches to the daemon's own path,
# /usr/libexec/iphonebridge/iphonebridge-daemon. systemd's file system
# sandboxing (ProtectSystem=, ProtectHome=, PrivateTmp=) needs a mount
# namespace, which a user unit only gets inside a user namespace; Ubuntu
# restricts those, so systemd silently skips the settings. These work
# without one:
NoNewPrivileges=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# Message history and the contacts cache are readable by this user only.
UMask=0077

[Install]
WantedBy=default.target
