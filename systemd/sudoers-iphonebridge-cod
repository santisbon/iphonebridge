# Rendered by install-cod-sudoers.sh, which substitutes @USER@ and
# @BTMGMT@, runs visudo -c on the result, and only then copies it to
# /etc/sudoers.d/iphonebridge-cod. Don't copy this file there by hand;
# unsubstituted placeholders are not valid sudoers syntax.
#
# Allows the iphonebridge user daemon to set the adapter CoD without a
# password prompt. The single specific command is the only thing this
# rule unlocks — btmgmt with any other arguments still requires a
# password. See spike/RESULTS.md §1 for why this command is load-bearing.
#
# Install with:
#   sudo bash systemd/install-cod-sudoers.sh

@USER@ ALL=(root) NOPASSWD: @BTMGMT@ class 4 8
