#!/usr/bin/make -f
export PYBUILD_NAME = iphonebridge
# Tests run in CI; the build environment has no pytest.
export PYBUILD_DISABLE = test

%:
	dh $@ --with python3 --buildsystem=pybuild

# The man sources carry @VERSION@/@DATE@ rather than a literal version:
# a hardcoded one is an extra version location the release bump can miss
# (and did — 0.12.0 shipped man pages saying 0.11.0). The changelog is
# the single source here.
execute_before_dh_installman:
	mkdir -p debian/man-gen
	set -e; V=$$(dpkg-parsechangelog -S Version); \
	D=$$(date -u -d "$$(dpkg-parsechangelog -S Date)" +%Y-%m-%d); \
	for m in man/*.1; do \
	  sed "s/@VERSION@/$$V/; s/@DATE@/$$D/" $$m > debian/man-gen/$$(basename $$m); \
	done

override_dh_install:
	dh_install
	mkdir -p debian/iphonebridge/usr/lib/systemd/user
	sed "s|@INSTALL_DIR@/.venv/bin/iphonebridge run|/usr/libexec/iphonebridge/iphonebridge-daemon|" \
	  systemd/iphonebridge.service \
	  > debian/iphonebridge/usr/lib/systemd/user/iphonebridge.service
	dh_apparmor --profile-name=iphonebridge -piphonebridge

# iphonebridge-cod.service runs when the daemon finds the adapter's class
# wrong, not at package installation.
override_dh_installsystemd:
	dh_installsystemd --no-start iphonebridge-cod.service
